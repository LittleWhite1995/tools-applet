.party-dice-icon {
  position: relative;
  display: block;
  box-sizing: border-box;
}

.mini-cup {
  position: absolute;
  top: 4%;
  left: 10%;
  width: 64%;
  height: 68%;
  transform: rotate(-7deg);
}

.mini-cup-rim {
  position: absolute;
  top: 0;
  left: 3%;
  z-index: 2;
  width: 94%;
  height: 18%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #bd6146, #713025);
  box-shadow: 0 2rpx 4rpx rgba(48, 20, 16, 0.24);
}

.mini-cup-body {
  position: absolute;
  top: 8%;
  left: 10%;
  width: 80%;
  height: 78%;
  border-radius: 14% 14% 30% 30%;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.16), transparent 26%),
    linear-gradient(145deg, #bd6046, #803629 62%, #52241d);
  box-shadow: 0 7rpx 9rpx rgba(59, 26, 20, 0.24);
}

.mini-die {
  position: absolute;
  z-index: 3;
  width: 35%;
  height: 35%;
  border-radius: 22%;
  background: linear-gradient(145deg, #fffefb, #f0e4d8);
  box-shadow: 0 4rpx 7rpx rgba(91, 57, 42, 0.18);
}

.mini-die-left {
  right: 18%;
  bottom: 5%;
  transform: rotate(9deg);
}

.mini-die-right {
  right: 0;
  bottom: 24%;
  transform: rotate(-10deg) scale(0.86);
}

.mini-pip {
  position: absolute;
  width: 15%;
  height: 15%;
  border-radius: 50%;
  background: #70483a;
}

.mini-pip-tl {
  top: 20%;
  left: 20%;
}

.mini-pip-tr {
  top: 20%;
  right: 20%;
}

.mini-pip-center {
  top: 42.5%;
  left: 42.5%;
}

.mini-pip-bl {
  bottom: 20%;
  left: 20%;
}

.mini-pip-br {
  right: 20%;
  bottom: 20%;
}
