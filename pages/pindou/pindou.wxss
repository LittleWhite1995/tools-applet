page {
  height: 100vh;
  overflow: hidden;
  background: #fff9f3;
  color: #35231f;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #fff9f3;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: #fff9f3;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 70rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff1e4 0%, #fffdf9 34%, #fff9f3 100%);
}

.hero-panel,
.hero-mark,
.card-head,
.image-preview,
.uploader,
.chip-grid,
.custom-chip,
.switch-row,
.switch-control,
.editor-toolbar,
.tool-group,
.color-button,
.zoom-group,
.stat-item,
.export-preview,
.save-row,
.save-action,
.palette-head,
.palette-grid {
  display: flex;
}

.hero-panel {
  position: relative;
  align-items: center;
  justify-content: space-between;
  min-height: 218rpx;
  padding: 34rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(255, 235, 218, 0.98), rgba(255, 255, 255, 0.92)),
    linear-gradient(90deg, rgba(200, 95, 63, 0.14), rgba(166, 58, 70, 0.1));
  box-shadow: 0 18rpx 38rpx rgba(112, 66, 48, 0.09);
}

.hero-panel::before {
  position: absolute;
  right: -110rpx;
  top: -92rpx;
  width: 410rpx;
  height: 340rpx;
  border-radius: 88rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0) 18%, rgba(255, 255, 255, 0.55) 52%, rgba(255, 255, 255, 0) 86%),
    linear-gradient(160deg, rgba(200, 95, 63, 0.16), rgba(166, 58, 70, 0.02));
  transform: rotate(-16deg);
  content: '';
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 460rpx;
}

.hero-kicker {
  color: #c85f3f;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #35231f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 10rpx;
  color: #75635c;
  font-size: 25rpx;
  line-height: 1.45;
}

.hero-mark {
  position: relative;
  z-index: 1;
  align-items: center;
  justify-content: center;
  width: 138rpx;
  height: 138rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.62);
}

.panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(105, 61, 45, 0.06);
}

.card-head {
  align-items: center;
  justify-content: space-between;
}

.card-title {
  color: #35231f;
  font-size: 30rpx;
  font-weight: 700;
}

.card-subtitle,
.helper-note,
.image-desc,
.upload-desc,
.switch-desc,
.editor-tip,
.save-desc,
.palette-desc {
  margin-top: 6rpx;
  color: #8a756c;
  font-size: 23rpx;
  line-height: 1.5;
}

.setting-value,
.result-badge {
  flex: none;
  padding: 11rpx 17rpx;
  border-radius: 999rpx;
  color: #c85f3f;
  font-size: 21rpx;
  font-weight: 700;
  background: #fff0e3;
}

.image-preview,
.uploader {
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #fff6ed;
}

.preview-thumb {
  flex: none;
  width: 98rpx;
  height: 98rpx;
  border-radius: 22rpx;
  background: #f1dfd3;
}

.image-info,
.upload-copy,
.save-copy,
.switch-copy,
.stat-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.image-title,
.upload-title,
.switch-title,
.save-title,
.stat-code {
  color: #35231f;
  font-size: 27rpx;
  font-weight: 700;
}

.change-button {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #c85f3f;
  font-size: 23rpx;
  font-weight: 700;
  background: #f8ded1;
}

.upload-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #f8ded1;
}

.setting-block {
  margin-top: 30rpx;
}

.setting-label {
  margin-bottom: 16rpx;
  color: #4c3933;
  font-size: 25rpx;
  font-weight: 700;
}

.chip-grid {
  flex-wrap: wrap;
  justify-content: space-between;
  margin: -6rpx 0;
}

.option-chip,
.custom-chip {
  width: 32%;
  min-height: 68rpx;
  margin: 6rpx 0;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  box-sizing: border-box;
  color: #806d65;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 64rpx;
  text-align: center;
  background: #fff7f0;
}

.option-chip.is-active,
.custom-chip.is-active {
  border-color: #c85f3f;
  color: #9f432f;
  background: #fff0e3;
}

.custom-chip {
  width: 100%;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  line-height: 1;
}

.custom-input {
  width: 82rpx;
  height: 62rpx;
  color: inherit;
  font-size: 23rpx;
  font-weight: 650;
  text-align: right;
}

.custom-chip text {
  margin-left: 5rpx;
}

.helper-note {
  padding: 10rpx 4rpx 0;
}

.switch-row {
  align-items: center;
  margin-top: 30rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #fff9f3;
}

.switch-copy {
  margin-left: 0;
}

.switch-control {
  flex: none;
  align-items: center;
  width: 86rpx;
  height: 48rpx;
  padding: 5rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #ddc8bd;
  transition: background 160ms ease;
}

.switch-control.is-on {
  justify-content: flex-end;
  background: #c85f3f;
}

.switch-dot {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 3rpx 8rpx rgba(114, 61, 45, 0.2);
}

.generate-button {
  display: block;
  margin-top: 28rpx;
  --td-button-primary-bg-color: #c85f3f;
  --td-button-primary-border-color: #c85f3f;
  --td-button-primary-active-bg-color: #9f432f;
  --td-button-primary-active-border-color: #9f432f;
}

.result-badge {
  color: #918079;
  background: #f5e9e2;
}

.result-badge.is-ready {
  color: #c85f3f;
  background: #fff0e3;
}

.editor-toolbar {
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.tool-group,
.zoom-group {
  align-items: center;
}

.tool-button,
.square-button,
.zoom-button,
.zoom-value {
  height: 62rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  color: #7a6760;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
  background: #fff5ed;
}

.tool-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 0 14rpx;
  line-height: 1;
}

.tool-group-primary {
  width: 100%;
}

.tool-button + .tool-button,
.square-button + .square-button {
  margin-left: 8rpx;
}

.tool-button.is-active {
  color: #ffffff;
  background: #c85f3f;
}

.tool-button text,
.square-button text {
  margin-left: 8rpx;
}

.color-picker-card {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #f0dfd6;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #fffaf5, #fff3e8);
}

.color-preview-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 2rpx solid rgba(86, 52, 42, 0.12);
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(105, 61, 45, 0.1);
}

.color-preview {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.color-picker-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.color-picker-label {
  color: #95847d;
  font-size: 20rpx;
  line-height: 1.2;
}

.color-picker-value {
  margin-top: 5rpx;
  color: #35231f;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.2;
}

.color-picker-action {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  color: #c85f3f;
  font-size: 22rpx;
  font-weight: 700;
}

.toolbar-secondary {
  margin-top: 12rpx;
}

.square-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  padding: 0 16rpx;
  line-height: 1;
}

.square-button.is-disabled {
  opacity: 0.42;
}

.zoom-button {
  width: 60rpx;
  font-size: 30rpx;
}

.zoom-value {
  min-width: 76rpx;
  margin: 0 6rpx;
  background: transparent;
}

.editor-scroll {
  width: 100%;
  height: 620rpx;
  margin-top: 20rpx;
  border: 1rpx solid #f0dfd6;
  border-radius: 26rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    linear-gradient(45deg, #f7eee8 25%, transparent 25%) 0 0 / 24rpx 24rpx,
    linear-gradient(-45deg, #f7eee8 25%, transparent 25%) 0 12rpx / 24rpx 24rpx,
    linear-gradient(45deg, transparent 75%, #f7eee8 75%) 12rpx -12rpx / 24rpx 24rpx,
    linear-gradient(-45deg, transparent 75%, #f7eee8 75%) -12rpx 0 / 24rpx 24rpx,
    #ffffff;
}

.editor-canvas {
  position: absolute;
  display: block;
}

.editor-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.editor-tip {
  padding: 6rpx 4rpx 0;
  text-align: center;
}

.result-empty {
  min-height: 160rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  color: #8a756c;
  font-size: 24rpx;
  line-height: 1.6;
  background: #fff9f3;
}

.replace-hint {
  color: #a63a46;
  font-size: 21rpx;
  font-weight: 700;
}

.stats-list {
  margin-top: 18rpx;
}

.stat-item {
  align-items: center;
  min-height: 106rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f4e9e3;
}

.stat-item:last-child {
  border-bottom: 0;
}

.stat-swatch {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid rgba(71, 45, 38, 0.08);
  border-radius: 20rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 800;
}

.stat-main {
  margin-left: 18rpx;
}

.stat-code {
  font-size: 25rpx;
}

.stat-hex,
.stat-percent {
  margin-top: 5rpx;
  color: #9a8982;
  font-size: 21rpx;
}

.stat-count {
  flex: none;
  text-align: right;
}

.stat-number {
  color: #c85f3f;
  font-size: 25rpx;
  font-weight: 700;
}

.export-preview {
  position: relative;
  align-items: center;
  justify-content: center;
  height: 460rpx;
  margin-top: 22rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #fff7f0;
}

.export-image {
  width: 100%;
  height: 100%;
}

.preview-mask {
  position: absolute;
  left: 50%;
  bottom: 22rpx;
  padding: 11rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  background: rgba(81, 43, 35, 0.76);
  transform: translateX(-50%);
}

.export-button {
  display: block;
  margin-top: 24rpx;
  --td-button-primary-bg-color: #c85f3f;
  --td-button-primary-border-color: #c85f3f;
  --td-button-primary-active-bg-color: #9f432f;
  --td-button-primary-active-border-color: #9f432f;
}

.save-row {
  align-items: center;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #fff9f3;
}

.save-copy {
  margin-left: 0;
}

.save-action {
  flex: none;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  background: #e4d3c9;
}

.save-row.is-ready .save-action {
  background: #c85f3f;
}

.palette-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(52, 31, 26, 0.42);
}

.palette-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 30rpx 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 -20rpx 50rpx rgba(87, 45, 36, 0.16);
}

.palette-head {
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 22rpx;
}

.palette-title {
  color: #35231f;
  font-size: 30rpx;
  font-weight: 700;
}

.palette-close {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #c85f3f;
  font-size: 23rpx;
  font-weight: 700;
  background: #fff0e3;
}

.palette-scroll {
  height: 58vh;
}

.palette-grid {
  flex-wrap: wrap;
  padding-bottom: 20rpx;
}

.palette-color {
  position: relative;
  width: 25%;
  padding: 8rpx;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.palette-color.is-selected {
  border-color: #c85f3f;
  background: #fff0e6;
  box-shadow: 0 6rpx 16rpx rgba(200, 95, 63, 0.2);
}

.palette-selected-mark {
  position: absolute;
  z-index: 1;
  right: -5rpx;
  top: -5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  background: #c85f3f;
}

.palette-swatch {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border: 2rpx solid rgba(71, 45, 38, 0.08);
  border-radius: 17rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 800;
}

.palette-hex {
  margin-top: 6rpx;
  overflow: hidden;
  color: #95847d;
  font-size: 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .hero-copy {
    width: 430rpx;
  }

  .hero-title {
    font-size: 35rpx;
  }

  .hero-mark {
    width: 126rpx;
    height: 126rpx;
  }

  .tool-button {
    min-width: 82rpx;
    padding: 0 12rpx;
  }
}
