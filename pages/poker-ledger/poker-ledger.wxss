page {
  background: #f7f5fb;
  color: #15231f;
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f7f5fb;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: #f7f5fb;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #f5f2fb 0%, #fcfbfe 34%, #f7f5fb 100%);
}

.hero-panel,
.hero-mark,
.field-row,
.field-icon,
.button-row,
.settlement-head,
.settlement-stats,
.stat-pill,
.chooser-list,
.player-input-row,
.saved-actions {
  display: flex;
}

.hero-panel {
  position: relative;
  align-items: center;
  justify-content: space-between;
  min-height: 216rpx;
  padding: 34rpx 34rpx 32rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(242, 237, 252, 0.96), rgba(251, 249, 255, 0.92)),
    linear-gradient(90deg, rgba(102, 85, 166, 0.12), rgba(155, 127, 214, 0.08));
  box-shadow: 0 18rpx 38rpx rgba(71, 55, 112, 0.08);
}

.hero-panel::before {
  position: absolute;
  right: -120rpx;
  top: -92rpx;
  width: 420rpx;
  height: 340rpx;
  border-radius: 80rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0) 12%, rgba(255, 255, 255, 0.46) 50%, rgba(255, 255, 255, 0) 84%),
    linear-gradient(150deg, rgba(102, 85, 166, 0.1), rgba(155, 127, 214, 0));
  transform: rotate(-16deg);
  content: '';
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 460rpx;
}

.hero-kicker {
  color: #6655a6;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 12rpx;
  color: #201a35;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 10rpx;
  color: #675f7f;
  font-size: 25rpx;
  line-height: 1.45;
}

.hero-mark {
  position: relative;
  z-index: 1;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.42);
}

.form-card,
.result-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(58, 49, 82, 0.05);
}

.card-title {
  color: #201a35;
  font-size: 30rpx;
  font-weight: 700;
}

.field-list {
  margin-top: 24rpx;
}

.field-row {
  align-items: center;
  min-height: 122rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #faf8fd;
}

.field-row + .field-row {
  margin-top: 18rpx;
}

.field-row.compact {
  min-height: 110rpx;
}

.field-icon {
  flex: none;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 20rpx;
}

.tone-title,
.tone-note {
  background: #f1edfb;
}

.tone-player,
.tone-amount {
  background: #eee9fb;
}

.tone-loser {
  background: #f9ebeb;
}

.tone-winner {
  background: #edf5e8;
}

.field-icon-text {
  font-size: 28rpx;
  font-weight: 700;
}

.field-icon-text.loser {
  color: #b66161;
}

.field-icon-text.winner {
  color: #4d7b35;
}

.field-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.field-label,
.section-label,
.chooser-label,
.result-label,
.summary-label,
.detail-title {
  color: #7c7397;
  font-size: 23rpx;
  font-weight: 600;
}

.field-input {
  width: 100%;
  height: 52rpx;
  margin-top: 8rpx;
  color: #201a35;
  font-size: 34rpx;
  font-weight: 700;
}

.input-placeholder {
  color: #b0a9c2;
  font-weight: 500;
}

.field-unit {
  flex: none;
  color: #7c7397;
  font-size: 24rpx;
  font-weight: 600;
}

.player-input-row {
  align-items: center;
  margin-top: 8rpx;
}

.player-input {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.mini-action,
.saved-action {
  flex: none;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #6655a6;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
  background: #f1edfb;
}

.mini-action {
  margin-left: 16rpx;
}

.player-section,
.record-section {
  margin-top: 22rpx;
}

.player-list {
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.player-chip {
  display: inline-flex;
  align-items: center;
  flex: none;
  min-height: 54rpx;
  padding: 0 18rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #f6f2fd;
  color: #554d6c;
  font-size: 22rpx;
  font-weight: 700;
}

.player-chip-close {
  margin-left: 10rpx;
}

.compact-fields {
  margin-top: 22rpx;
}

.selector-row {
  position: relative;
}

.selector-row.is-disabled {
  opacity: 0.68;
}

.selector-value {
  margin-top: 8rpx;
  color: #aaa2be;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.selector-value.is-filled {
  color: #201a35;
}

.selector-action {
  flex: none;
  min-width: 84rpx;
  height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: #f1edfb;
  color: #6655a6;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-align: center;
}

.selection-preview {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f2fb;
  color: #7c7397;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.selection-preview.is-ready {
  color: #201a35;
}

.amount-fields {
  margin-top: 18rpx;
}

.helper-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f2fb;
  color: #6e6787;
  font-size: 22rpx;
  line-height: 1.55;
}

.button-row {
  margin-top: 24rpx;
}

.primary-button {
  --td-button-primary-bg-color: #6655a6;
  --td-button-primary-border-color: #6655a6;
  --td-button-primary-active-bg-color: #51428a;
  --td-button-primary-active-border-color: #51428a;
}

.record-list,
.balance-list,
.transfer-list,
.saved-list {
  margin-top: 14rpx;
}

.record-item,
.saved-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
}

.record-item + .record-item,
.saved-item + .saved-item {
  border-top: 1rpx solid #ece7f6;
}

.record-main,
.saved-main {
  min-width: 0;
  flex: 1;
}

.record-title,
.saved-title {
  color: #201a35;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.record-note,
.saved-meta,
.saved-desc {
  margin-top: 8rpx;
  color: #7c7397;
  font-size: 22rpx;
  line-height: 1.45;
}

.record-side {
  flex: none;
  margin-left: 20rpx;
  text-align: right;
}

.record-amount,
.transfer-value,
.balance-value {
  color: #201a35;
  font-size: 24rpx;
  font-weight: 700;
}

.record-delete,
.saved-action.danger {
  margin-top: 8rpx;
  color: #c56b6b;
}

.result-card {
  overflow: hidden;
}

.settlement-head {
  align-items: flex-start;
  justify-content: space-between;
}

.settlement-title {
  color: #201a35;
  font-size: 30rpx;
  font-weight: 700;
}

.settlement-subtitle {
  margin-top: 8rpx;
  color: #7c7397;
  font-size: 22rpx;
  line-height: 1.45;
}

.settlement-badge {
  flex: none;
  margin-left: 18rpx;
  min-width: 120rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1edfb;
  color: #6655a6;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.settlement-stats {
  align-items: center;
  margin-top: 20rpx;
}

.stat-pill {
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 58rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  background: #faf8fd;
}

.stat-pill + .stat-pill {
  margin-left: 12rpx;
}

.stat-label {
  color: #7c7397;
  font-size: 21rpx;
  font-weight: 600;
}

.stat-value {
  margin-left: 8rpx;
  color: #201a35;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.detail-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #faf8fd;
}

.transfer-title {
  margin-top: 24rpx;
}

.balance-item,
.transfer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.balance-item + .balance-item,
.transfer-item + .transfer-item {
  border-top: 1rpx solid #ece7f6;
}

.balance-name,
.transfer-text {
  color: #201a35;
  font-size: 25rpx;
  font-weight: 700;
}

.balance-meta {
  text-align: right;
}

.balance-status {
  color: #7c7397;
  font-size: 21rpx;
}

.balance-item.is-positive .balance-value {
  color: #4d7b35;
}

.balance-item.is-negative .balance-value {
  color: #c56b6b;
}

.balance-item.is-flat .balance-value {
  color: #7c7397;
}

.detail-note,
.empty-inline {
  color: #7c7397;
  font-size: 23rpx;
  line-height: 1.5;
}

.empty-inline {
  margin-top: 14rpx;
}

.settlement-actions {
  margin-top: 24rpx;
}

.save-button {
  width: 100%;
}

.new-session-link {
  margin-top: 28rpx;
  padding: 12rpx 0;
  color: #9b6b6b;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.saved-actions {
  flex: none;
  flex-direction: column;
  margin-left: 20rpx;
}

.saved-action + .saved-action {
  margin-top: 10rpx;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .hero-copy {
    width: 410rpx;
  }

  .hero-title {
    font-size: 34rpx;
  }

  .save-button {
    width: 100%;
  }
}
