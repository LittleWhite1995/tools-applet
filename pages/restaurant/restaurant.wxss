page {
  background: #f4f7f5;
  color: #15231f;
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f4f7f5;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: #f4f7f5;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #edf5f1 0%, #f8faf9 34%, #f4f7f5 100%);
}

.hero-panel,
.hero-mark,
.module-tabs,
.field-row,
.button-row,
.result-head,
.result-row {
  display: flex;
}

.hero-panel {
  position: relative;
  align-items: center;
  justify-content: space-between;
  min-height: 230rpx;
  padding: 34rpx 34rpx 32rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(222, 240, 233, 0.96), rgba(248, 251, 250, 0.92)),
    linear-gradient(90deg, rgba(36, 88, 77, 0.14), rgba(154, 106, 25, 0.07));
  box-shadow: 0 22rpx 50rpx rgba(27, 70, 58, 0.1);
}

.hero-panel::before {
  position: absolute;
  right: -120rpx;
  top: -92rpx;
  width: 420rpx;
  height: 340rpx;
  border-radius: 80rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0) 12%, rgba(255, 255, 255, 0.48) 50%, rgba(255, 255, 255, 0) 84%),
    linear-gradient(150deg, rgba(36, 88, 77, 0.1), rgba(154, 106, 25, 0));
  transform: rotate(-16deg);
  content: '';
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 460rpx;
}

.hero-kicker {
  color: #24584d;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 12rpx;
  color: #142a25;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 10rpx;
  color: #5e716c;
  font-size: 25rpx;
  line-height: 1.45;
}

.hero-mark {
  position: relative;
  z-index: 1;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.42);
}

.form-card,
.result-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 44rpx rgba(34, 63, 57, 0.07);
}

.module-tabs {
  padding: 8rpx;
  margin-bottom: 26rpx;
  border-radius: 999rpx;
  background: #f1f6f3;
}

.module-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  color: #73817d;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.module-tab.is-active {
  color: #24584d;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(27, 70, 58, 0.08);
}

.field-list {
  margin-top: 0;
}

.field-row {
  align-items: center;
  min-height: 104rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  background: #f5f9f7;
}

.field-row + .field-row {
  margin-top: 16rpx;
}

.field-main {
  min-width: 0;
  flex: 1;
}

.field-label {
  color: #7d8985;
  font-size: 22rpx;
}

.field-input {
  width: 100%;
  height: 50rpx;
  margin-top: 7rpx;
  color: #19251f;
  font-size: 32rpx;
  font-weight: 700;
}

.input-placeholder {
  color: #a1ada9;
  font-weight: 500;
}

.field-unit {
  flex: none;
  min-width: 68rpx;
  color: #7d8985;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

.button-row {
  margin-top: 24rpx;
}

.calculate-button {
  --td-button-primary-bg-color: #24584d;
  --td-button-primary-border-color: #24584d;
  --td-button-primary-active-bg-color: #1b463d;
  --td-button-primary-active-border-color: #1b463d;
}

.result-head {
  align-items: flex-start;
  justify-content: space-between;
}

.result-label {
  color: #7d8985;
  font-size: 23rpx;
}

.result-value {
  margin-top: 8rpx;
  color: #142a25;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.result-badge {
  min-width: 104rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #edf3f1;
  color: #7d8985;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.result-badge.is-ready {
  color: #24584d;
  background: #e6f1ed;
}

.result-notice {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff4e1;
  color: #8a5a12;
  font-size: 24rpx;
  line-height: 1.45;
}

.result-list {
  margin-top: 28rpx;
  padding: 8rpx 0;
  border-radius: 26rpx;
  background: #f5f9f7;
}

.result-row {
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding: 0 24rpx;
}

.result-row + .result-row {
  border-top: 1rpx solid #e6eee9;
}

.row-label {
  color: #7d8985;
  font-size: 24rpx;
}

.row-value {
  color: #19251f;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
}

.result-tip {
  margin-top: 22rpx;
  color: #5e716c;
  font-size: 25rpx;
  line-height: 1.5;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .hero-copy {
    width: 420rpx;
  }

  .hero-title {
    font-size: 34rpx;
  }

  .module-tab {
    font-size: 22rpx;
  }
}
