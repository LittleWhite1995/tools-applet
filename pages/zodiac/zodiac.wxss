page {
  height: 100vh;
  overflow: hidden;
  color: #162033;
  background: #18233d;
}

.shell {
  display: flex;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: #18233d;
}

.page-scroll {
  height: 0;
  min-height: 0;
  flex: 1;
  background: #18233d;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 10%, rgba(212, 164, 77, 0.12), transparent 24%),
    radial-gradient(circle at 10% 8%, rgba(94, 125, 196, 0.16), transparent 22%),
    linear-gradient(180deg, #141d34 0%, #1c2a48 48%, #223252 100%);
}

.hero-panel,
.hero-mark,
.zodiac-grid,
.zodiac-option,
.result-head,
.info-grid,
.keyword-list {
  display: flex;
}

.hero-panel {
  position: relative;
  min-height: 228rpx;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 34rpx;
  border-radius: 42rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 24%, rgba(240, 195, 107, 0.2), transparent 24%),
    linear-gradient(135deg, #16213d, #22345c 56%, #12203c);
  box-shadow: 0 28rpx 56rpx rgba(13, 21, 42, 0.28);
}

.hero-stars {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
}

.star-a {
  top: 34rpx;
  left: 46rpx;
  width: 10rpx;
  height: 10rpx;
}

.star-b {
  top: 56rpx;
  right: 160rpx;
  width: 8rpx;
  height: 8rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 480rpx;
}

.hero-kicker {
  color: #f0c36b;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 14rpx;
  color: #f7f1e8;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(239, 233, 224, 0.76);
  font-size: 25rpx;
  line-height: 1.58;
}

.hero-mark {
  position: relative;
  z-index: 1;
  width: 128rpx;
  height: 128rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(240, 195, 107, 0.18);
}

.selector-card,
.result-card {
  position: relative;
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 24%, rgba(240, 195, 107, 0.16), transparent 24%),
    linear-gradient(135deg, #16213d, #22345c 56%, #12203c);
  box-shadow: 0 24rpx 48rpx rgba(13, 21, 42, 0.24);
}

.selector-card::after,
.result-card::after {
  position: absolute;
  top: 44rpx;
  right: 68rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.52);
  box-shadow:
    -420rpx 36rpx 0 rgba(255, 255, 255, 0.24),
    -300rpx 136rpx 0 rgba(240, 195, 107, 0.18),
    48rpx 84rpx 0 rgba(255, 255, 255, 0.18);
  content: '';
}

.card-title,
.card-subtitle,
.zodiac-grid,
.result-head,
.info-grid,
.section-title,
.keyword-list,
.desc-card,
.reference-note,
.result-empty {
  position: relative;
  z-index: 1;
}

.card-title {
  color: #f4ede3;
  font-size: 30rpx;
  font-weight: 700;
}

.card-subtitle {
  margin-top: 8rpx;
  color: rgba(215, 223, 238, 0.72);
  font-size: 23rpx;
}

.zodiac-grid {
  flex-wrap: wrap;
  margin: 24rpx -6rpx -12rpx;
}

.zodiac-option {
  width: calc(25% - 12rpx);
  min-height: 154rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 6rpx 12rpx;
  padding: 14rpx 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  box-sizing: border-box;
  color: rgba(229, 235, 245, 0.78);
  background: rgba(255, 255, 255, 0.07);
  transition: transform 80ms ease-out, background 120ms ease-out;
}

.zodiac-option:active {
  transform: scale(0.96);
}

.zodiac-option.is-active {
  border-color: rgba(240, 195, 107, 0.5);
  color: #f4ede3;
  background: rgba(240, 195, 107, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(240, 195, 107, 0.12);
}

.zodiac-option-symbol {
  color: #f0c36b;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.zodiac-option-name {
  margin-top: 10rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.zodiac-option-range {
  margin-top: 8rpx;
  color: rgba(215, 223, 238, 0.58);
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
}

.zodiac-option.is-active .zodiac-option-range {
  color: rgba(244, 237, 227, 0.72);
}

.result-card {
  min-height: 300rpx;
}

.result-card.is-active {
  background:
    radial-gradient(circle at 78% 24%, rgba(240, 195, 107, 0.2), transparent 24%),
    linear-gradient(135deg, #182542, #273b67 56%, #15233f);
}

.result-head {
  align-items: center;
  justify-content: space-between;
}

.result-copy {
  min-width: 0;
  flex: 1;
}

.result-label,
.info-label,
.section-title {
  color: rgba(215, 223, 238, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.result-name {
  margin-top: 8rpx;
  color: #f4ede3;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.result-meta {
  margin-top: 10rpx;
  color: #f0c36b;
  font-size: 24rpx;
  font-weight: 600;
}

.result-range {
  margin-top: 8rpx;
  color: rgba(215, 223, 238, 0.68);
  font-size: 23rpx;
}

.zodiac-symbol {
  min-width: 96rpx;
  flex: none;
  margin-left: 20rpx;
  color: #f0c36b;
  font-size: 84rpx;
  line-height: 1;
  text-align: center;
  text-shadow: 0 8rpx 18rpx rgba(240, 195, 107, 0.18);
}

.info-grid {
  justify-content: space-between;
  margin-top: 26rpx;
}

.info-item {
  width: calc(50% - 8rpx);
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08);
}

.info-value {
  margin-top: 10rpx;
  color: #f4ede3;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-title {
  margin-top: 26rpx;
}

.keyword-list {
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.keyword-chip {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #f0c36b;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(240, 195, 107, 0.12);
  box-shadow: inset 0 0 0 1rpx rgba(240, 195, 107, 0.16);
}

.desc-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  color: rgba(229, 235, 245, 0.9);
  font-size: 26rpx;
  line-height: 1.68;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.08);
}

.reference-note {
  margin-top: 20rpx;
  color: rgba(215, 223, 238, 0.48);
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.result-empty {
  padding: 44rpx 22rpx;
  text-align: center;
}

.empty-symbol {
  color: #f0c36b;
  font-size: 52rpx;
  line-height: 1;
}

.empty-title {
  margin-top: 18rpx;
  color: #f4ede3;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 14rpx;
  color: rgba(215, 223, 238, 0.74);
  font-size: 26rpx;
  line-height: 1.65;
}

@media (max-width: 360px) {
  .page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .hero-title {
    font-size: 34rpx;
  }

  .hero-copy {
    max-width: 430rpx;
  }

  .zodiac-option {
    min-height: 148rpx;
  }

  .zodiac-option-name {
    font-size: 21rpx;
  }

  .zodiac-option-range {
    font-size: 17rpx;
  }

  .result-name {
    font-size: 44rpx;
  }
}
