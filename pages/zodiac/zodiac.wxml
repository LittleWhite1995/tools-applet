<view class="shell">
  <navigation-bar title="星座查询" back="{{true}}" color="#f6efe6" background="#111a2f"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page">
      <view class="hero-panel">
        <view class="hero-stars star-a"></view>
        <view class="hero-stars star-b"></view>
        <view class="hero-copy">
          <view class="hero-kicker">ZODIAC LOOKUP</view>
          <view class="hero-title">选择星座，查看资料</view>
          <view class="hero-desc">直接选择想了解的星座，即可查看日期范围和基础信息。</view>
        </view>
        <view class="hero-mark">
          <t-icon name="star-filled" size="82rpx" color="#f0c36b" />
        </view>
      </view>

      <view class="selector-card">
        <view class="card-title">十二星座</view>
        <view class="card-subtitle">点击一个星座查看详情</view>

        <view class="zodiac-grid">
          <view
            wx:for="{{zodiacList}}"
            wx:key="id"
            class="zodiac-option {{selectedZodiacId === item.id ? 'is-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectZodiac"
          >
            <text class="zodiac-option-symbol">{{item.icon}}</text>
            <text class="zodiac-option-name">{{item.name}}</text>
            <text class="zodiac-option-range">{{item.range}}</text>
          </view>
        </view>
      </view>

      <view class="result-card {{hasResult ? 'is-active' : ''}}">
        <block wx:if="{{hasResult}}">
          <view class="result-head">
            <view class="result-copy">
              <view class="result-label">当前选择</view>
              <view class="result-name">{{zodiac.name}}</view>
              <view class="result-meta">{{zodiac.enName}}</view>
              <view class="result-range">日期范围 · {{zodiac.range}}</view>
            </view>
            <view class="zodiac-symbol">{{zodiac.icon}}</view>
          </view>

          <view class="info-grid">
            <view class="info-item">
              <view class="info-label">属性</view>
              <view class="info-value">{{zodiac.element}}</view>
            </view>
            <view class="info-item">
              <view class="info-label">守护星</view>
              <view class="info-value">{{zodiac.ruler}}</view>
            </view>
          </view>

          <view class="section-title">关键词</view>
          <view class="keyword-list">
            <view wx:for="{{zodiac.keywords}}" wx:key="*this" class="keyword-chip">{{item}}</view>
          </view>

          <view class="section-title">性格印象</view>
          <view class="desc-card">{{zodiac.desc}}</view>
          <view class="reference-note">内容仅作为星座文化与娱乐参考。</view>
        </block>

        <view wx:else class="result-empty">
          <view class="empty-symbol">✦</view>
          <view class="empty-title">请选择一个星座</view>
          <view class="empty-desc">选中后，这里会显示对应的日期范围和基础资料。</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
