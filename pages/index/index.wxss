/* index.wxss */
page {
  background: #f8fbf9;
  color: #15231f;
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f8fbf9;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: #f8fbf9;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #f5fbf8 0%, #fdfefd 34%, #f8fbf9 100%);
}

.top-area {
  padding-top: 4rpx;
}

.section-head,
.section-more,
.quick-tags,
.hero-card,
.hero-badge,
.hero-action,
.tool-grid,
.topic-card {
  display: flex;
}

.search {
  display: block;
  margin-bottom: 18rpx;
  --td-search-bg-color: transparent;
}

.search-input {
  height: 92rpx !important;
  border-radius: 46rpx !important;
  background: rgba(255, 255, 255, 0.98) !important;
  box-shadow: 0 14rpx 36rpx rgba(33, 73, 65, 0.05);
}

.quick-tags {
  overflow-x: auto;
  padding: 2rpx 4rpx 26rpx;
  white-space: nowrap;
}

.quick-tag {
  flex: none;
  --td-tag-primary-color: #24584d;
  --td-tag-primary-light-color: #e5f3ef;
}

.quick-tag + .quick-tag {
  margin-left: 14rpx;
}

.hero-card {
  position: relative;
  align-items: center;
  justify-content: space-between;
  min-height: 270rpx;
  padding: 34rpx 34rpx 34rpx 36rpx;
  border-radius: 44rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(224, 240, 234, 0.96), rgba(246, 250, 248, 0.92)),
    linear-gradient(90deg, rgba(36, 88, 77, 0.12), rgba(63, 115, 161, 0.08));
  box-shadow: 0 18rpx 40rpx rgba(27, 70, 58, 0.08);
}

.hero-card::before {
  position: absolute;
  top: -80rpx;
  right: -140rpx;
  width: 500rpx;
  height: 420rpx;
  background:
    linear-gradient(120deg, rgba(255, 255, 255, 0) 14%, rgba(255, 255, 255, 0.5) 48%, rgba(255, 255, 255, 0) 82%),
    linear-gradient(150deg, rgba(36, 88, 77, 0.1), rgba(86, 138, 126, 0));
  border-radius: 88rpx;
  transform: rotate(-16deg) translate3d(26rpx, 0, 0);
  animation: heroLightFloat 5.6s ease-in-out infinite alternate;
  content: '';
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 430rpx;
}

.hero-badge {
  align-items: center;
  display: inline-flex;
  height: 42rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(190, 220, 210, 0.72);
  color: #24584d;
  font-size: 18rpx;
  font-weight: 700;
}

.hero-badge text {
  margin-left: 8rpx;
}

.hero-title {
  margin-top: 24rpx;
  color: #142a25;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 10rpx;
  width: 360rpx;
  color: #51625d;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
}

.hero-action {
  align-items: center;
  margin-top: 26rpx;
  color: #24584d;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-action text {
  margin-right: 10rpx;
}

.hero-visual {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.46);
}

.section-head {
  align-items: center;
  justify-content: space-between;
  margin: 44rpx 2rpx 22rpx;
}

.topic-section-head {
  margin-top: 12rpx;
}

.section-title {
  color: #17231f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-more {
  align-items: center;
  color: #72817d;
  font-size: 24rpx;
  font-weight: 500;
}

.tool-grid {
  flex-wrap: wrap;
  justify-content: space-between;
}

.tool-card {
  width: calc(50% - 12rpx);
  min-height: 198rpx;
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(34, 63, 57, 0.05);
}

.hero-card,
.tool-card,
.topic-card {
  transform: translateZ(0);
  transition: transform 80ms ease-out, opacity 80ms ease-out;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  margin-bottom: 28rpx;
}

.tool-icon-image {
  width: 54rpx;
  height: 54rpx;
}

.tone-mint {
  color: #2f7567;
  background: #e5f3ef;
}

.tone-sky {
  color: #2d6895;
  background: #e7f0f7;
}

.tone-amber {
  color: #9a6a19;
  background: #f7efd9;
}

.tone-violet {
  color: #6655a6;
  background: #eeeaf8;
}

.tone-coral {
  color: #a85b52;
  background: #f7e8e4;
}

.tone-green {
  color: #4d7b35;
  background: #e7f1df;
}

.tone-red {
  color: #c83737;
  background: #fbe8e8;
}

.tone-indigo {
  color: #5d67d8;
  background: #cfd8ff;
}

.tool-icon.has-white-icon-bg {
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(28, 48, 43, 0.06);
}

.tool-title {
  color: #19251f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.tool-desc {
  margin-top: 8rpx;
  color: #7d8985;
  font-size: 23rpx;
  line-height: 1.35;
}

.topic-list {
  display: block;
}

.topic-card {
  position: relative;
  justify-content: space-between;
  min-height: 292rpx;
  padding: 44rpx 44rpx 36rpx;
  border-radius: 42rpx;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 18rpx 40rpx rgba(24, 54, 47, 0.08);
}

.topic-card + .topic-card {
  margin-top: 24rpx;
}

.topic-deep {
  color: #c8e6dd;
  background: linear-gradient(135deg, #1f5f54, #183f3a 58%, #0f3028);
}

.topic-copy {
  position: relative;
  z-index: 1;
  width: 450rpx;
}

.topic-label {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #f2fbf7;
  font-size: 20rpx;
  font-weight: 700;
}

.topic-title {
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.topic-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
  line-height: 1.5;
}

.topic-button {
  margin-top: 28rpx;
  min-width: 190rpx;
  --td-button-primary-bg-color: #ffffff;
  --td-button-primary-border-color: #ffffff;
  --td-button-primary-color: #183f3a;
  --td-button-primary-active-bg-color: #dceee7;
  --td-button-primary-active-border-color: #dceee7;
}

.topic-icon {
  position: absolute;
  right: 30rpx;
  bottom: 26rpx;
  opacity: 0.28;
}

.is-pressing {
  opacity: 0.94;
  transform: scale(0.99) translateZ(0);
}

@keyframes heroLightFloat {
  from {
    opacity: 0.5;
    transform: rotate(-16deg) translate3d(26rpx, 0, 0);
  }

  to {
    opacity: 0.86;
    transform: rotate(-16deg) translate3d(-28rpx, 18rpx, 0);
  }
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .hero-copy {
    width: 400rpx;
  }

  .hero-title {
    font-size: 34rpx;
  }

  .hero-desc {
    width: 330rpx;
    font-size: 25rpx;
  }

  .hero-visual {
    width: 150rpx;
    height: 150rpx;
  }
}


