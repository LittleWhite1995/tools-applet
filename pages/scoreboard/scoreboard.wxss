page {
  height: 100vh;
  overflow: hidden;
  background: #f3f4f6;
  color: #182230;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f3f4f6;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.page {
  min-height: 100%;
  padding: 24rpx 28rpx 64rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 92% 4%, rgba(202, 216, 234, 0.7), transparent 28%),
    linear-gradient(180deg, #f3f4f6 0%, #f8f9fb 100%);
}

.hero-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 250rpx;
  padding: 38rpx 36rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(135deg, #17243b 0%, #223a5c 58%, #2e527c 100%);
  box-shadow: 0 20rpx 42rpx rgba(23, 36, 59, 0.16);
}

.hero-card::after {
  position: absolute;
  right: -50rpx;
  bottom: -150rpx;
  width: 430rpx;
  height: 430rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  box-shadow: 0 0 0 48rpx rgba(255, 255, 255, 0.035), 0 0 0 96rpx rgba(255, 255, 255, 0.025);
  content: '';
}

.hero-copy,
.hero-mark {
  position: relative;
  z-index: 1;
}

.hero-copy {
  width: 410rpx;
}

.hero-kicker {
  color: #a9c7e8;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.24;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
  line-height: 1.5;
}

.hero-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 32rpx;
  background: rgba(9, 19, 34, 0.28);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

.continue-card,
.section-card,
.tips-card {
  margin-top: 24rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(35, 50, 70, 0.06);
}

.continue-card {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border: 2rpx solid #dce5ef;
}

.continue-main {
  min-width: 0;
  flex: 1;
}

.continue-label {
  color: #315f8f;
  font-size: 20rpx;
  font-weight: 800;
}

.continue-title {
  margin-top: 8rpx;
  overflow: hidden;
  color: #182230;
  font-size: 27rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-note {
  margin-top: 6rpx;
  color: #73808f;
  font-size: 21rpx;
}

.continue-button {
  flex: none;
  min-width: 142rpx;
  height: 66rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 66rpx;
  text-align: center;
  background: #315f8f;
}

.section-card {
  padding: 30rpx;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-title {
  color: #182230;
  font-size: 30rpx;
  font-weight: 800;
}

.section-desc {
  margin-top: 8rpx;
  color: #768290;
  font-size: 22rpx;
  line-height: 1.4;
}

.step-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
  background: #315f8f;
}

.mode-list {
  margin-top: 24rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #f6f7f9;
  transition: all 0.18s ease;
}

.mode-card + .mode-card {
  margin-top: 16rpx;
}

.mode-card.is-selected {
  border-color: #7194b8;
  background: #eef3f8;
  box-shadow: 0 8rpx 22rpx rgba(49, 95, 143, 0.08);
}

.mode-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.mode-badminton {
  background: linear-gradient(145deg, #718096, #52657e);
}

.mode-tableTennis {
  background: linear-gradient(145deg, #57779c, #385b82);
}

.mode-free {
  color: #675a34;
  background: linear-gradient(145deg, #f2d996, #dfbd63);
}

.mode-main {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.mode-name {
  color: #182230;
  font-size: 27rpx;
  font-weight: 800;
}

.mode-desc {
  margin-top: 6rpx;
  color: #768290;
  font-size: 21rpx;
  line-height: 1.4;
}

.mode-check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-left: 16rpx;
  border: 2rpx solid #ced5df;
  border-radius: 50%;
  box-sizing: border-box;
  background: #ffffff;
}

.mode-card.is-selected .mode-check {
  border-color: #315f8f;
  background: #315f8f;
}

.check-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: transparent;
}

.mode-card.is-selected .check-dot {
  background: #ffffff;
}

.player-card {
  padding-bottom: 28rpx;
}

.player-inputs {
  margin-top: 24rpx;
}

.player-input-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 22rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  background: #f6f7f9;
}

.player-color {
  flex: none;
  width: 12rpx;
  height: 58rpx;
  border-radius: 999rpx;
}

.color-red {
  background: #d9463d;
}

.color-blue {
  background: #2875d2;
}

.player-input-main {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.player-label {
  color: #7d8896;
  font-size: 20rpx;
  font-weight: 700;
}

.player-input {
  width: 100%;
  height: 48rpx;
  margin-top: 4rpx;
  color: #182230;
  font-size: 30rpx;
  font-weight: 800;
}

.versus {
  height: 34rpx;
  color: #929dab;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.start-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  margin-top: 28rpx;
  border-radius: 30rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #284f78 0%, #3a70a3 100%);
  box-shadow: 0 16rpx 30rpx rgba(40, 79, 120, 0.2);
}

.tips-card {
  padding: 24rpx 26rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: none;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  color: #707d8c;
  font-size: 21rpx;
  line-height: 1.5;
}

.tip-item + .tip-item {
  margin-top: 12rpx;
}

.tip-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 11rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #7194b8;
}

@media (max-width: 360px) {
  .hero-copy {
    width: 380rpx;
  }

  .hero-mark {
    width: 136rpx;
  }

  .hero-title {
    font-size: 35rpx;
  }
}
